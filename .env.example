NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used exclusively by the public invitation projection adapter.
SUPABASE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INVITATION_ENCRYPTION_KEY=
# Local database integration tests only; never a browser variable.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Optional transactional invitations and delivery polling; verified provider sender required.
RESEND_API_KEY=
EMAIL_FROM=
# Optional Pesapal API 3.0. JSON configurations documented in docs/PHASES-E-F.md.
# Separate platform subscription merchant from each planner's client-receipts merchant.
PESAPAL_PLATFORM_CONFIG=
PESAPAL_MERCHANTS=
# Organization-keyed Twilio WhatsApp sender/template configuration; server-only.
WHATSAPP_ACCOUNTS=
# Random secret protecting Vercel's approved WhatsApp dispatcher.
CRON_SECRET=
